{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pic Chop Crop",
  "version": "0.1.4",
  "identifier": "com.picchopcrop.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pic Chop Crop",
        "width": 980,
        "height": 760,
        "resizable": true,
        "backgroundColor": "#1B1C1F",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg"],
        "mimeType": "image/jpeg",
        "name": "JPEG Image",
        "role": "Viewer"
      },
      {
        "ext": ["png"],
        "mimeType": "image/png",
        "name": "PNG Image",
        "role": "Viewer"
      }
    ]
  }
}
